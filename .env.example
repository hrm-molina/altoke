# Variables de entorno para conectar Supabase en Al Toke
# Copia este archivo como .env.local y pon tus credenciales de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Email de contacto (Resend) — los formularios llegan a tu Gmail
# 1. Crea cuenta gratis en https://resend.com (con tu Gmail)
# 2. API Keys → Create API Key → pega aquí
RESEND_API_KEY=re_xxx
# Destino de los formularios de /contacto
CONTACTO_EMAIL_DESTINO=altokechile.info@gmail.com
# Remitente (con cuenta gratis usa onboarding@resend.dev sin cambiar nada)
CONTACTO_EMAIL_FROM="AlToke Chile <onboarding@resend.dev>"
